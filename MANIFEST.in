include LICENSE NOTICE.md README.md pyproject.toml uv.lock .gitattributes
include Dockerfile .dockerignore
recursive-include src *.py *.json *.onnx
recursive-include src/airbnb_price/site *
recursive-include frontend *.ts *.json *.html *.css *.mjs *.txt *.jpg
recursive-include tests *.py
recursive-include scripts *.py
recursive-include docs *.md
recursive-include .github *.yml
prune frontend/node_modules
prune frontend/dist
prune frontend/test-results
prune frontend/playwright-report
prune data
prune build
global-exclude *.pyc *.pkl *.pickle *.pem .env AB_NYC_2019.csv